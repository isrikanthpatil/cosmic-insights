{
  "expo": {
    "name": "Astropanth",
    "slug": "astropanth",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cosmic-insights",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.astropanth.cosmicinsights",
      "buildNumber": "1",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Astropanth uses the camera so you can set a profile photo.",
        "NSPhotoLibraryUsageDescription": "Astropanth accesses your photo library so you can choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "Astropanth saves images, such as your reports and Panchang cards, to your photo library when you choose to.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.astropanth.cosmicinsights",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B1A"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAdIdPermission",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B1A"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4240393056142568~7599931566",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ec24dfd-5f30-4d39-97e5-39a544f646fa"
      }
    },
    "owner": "isrikanthpatil"
  }
}
